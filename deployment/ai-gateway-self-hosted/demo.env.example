SUBSCRIPTION_ID='<subscription-id>'
LOCATION=swedencentral
RESOURCE_GROUP=rg-aigw-shgw-demo
SUFFIX=demo1234
PUBLISHER_NAME='AI Gateway Demo'
PUBLISHER_EMAIL=admin@example.com

# Set after Foundry creates the AI Gateway API and project subscription.
FOUNDRY_API_ID=
FOUNDRY_API_PATH=
APIM_SUBSCRIPTION_ID=

# Optional Codex CLI path. The setup script creates a dedicated Entra API.
FOUNDRY_PROJECT_NAME=proj-aigw-shgw-demo
CODEX_MODEL_DEPLOYMENT=gpt-5.1-codex
CODEX_ACCESS_GROUP='AI Gateway Codex Users'
# Keep false unless prompt/answer retention has explicit privacy approval.
CODEX_LOG_CONTENT=false
CODEX_CONTENT_MAX_CHARS=8000

# Block a category when its severity is greater than or equal to this value (1-7).
CONTENT_SAFETY_HATE_THRESHOLD=1
CONTENT_SAFETY_VIOLENCE_THRESHOLD=1
CONTENT_SAFETY_SEXUAL_THRESHOLD=1
CONTENT_SAFETY_SELF_HARM_THRESHOLD=1

# Set by setup-entra-demo.sh. Keep false until Easy Auth is configured.
ENABLE_ENTRA_AUTH=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
